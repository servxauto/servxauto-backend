                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status_code\": 429,\n  \"message\": \"Please wait before requesting another OTP\",\n  \"error_code\": \"OTP_RESEND_TOO_SOON\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('token', body.token);",
                  "  pm.environment.set('user_id', body.user.id);",
                  "  console.log('is_new_user:', body.is_new_user);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/user/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "user",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_no\": \"{{phone_no}}\",\n  \"otp\": {{otp}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Verifies the code and logs in. This is the only login step — there is no password.\n\n- `otp` — a **number**, not a string, so `{{otp}}` is unquoted in the body.\n- Creates the account if the phone number has none, returning `is_new_user: true`.\n- `user` is the full account row; `token` is a JWT carrying `{ sub: <account id>, actor: \"user\" }`, valid for `JWT_EXPIRES_IN` (30d by default).\n- The test script stores `token` and `user_id` in the environment."
          },

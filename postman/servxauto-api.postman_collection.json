                  "value": "application/json"
                }
              ],
              "body": "{\n  \"phone_no\": \"+919876543210\",\n  \"expires_at\": \"2026-10-11T09:20:00.000Z\",\n  \"resend_after_seconds\": 30\n}"
            },

            },
            {
              "name": "429 — resend too soon",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/auth/user/send-otp",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
